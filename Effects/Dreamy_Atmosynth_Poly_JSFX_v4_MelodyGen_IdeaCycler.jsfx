desc:Dreamy Atmosynth Poly v4 MelodyGen IdeaCycler (Debuggable JSFX Instrument)

slider1:0<0,11,1{Dream Keys,Dusty Pad,VHS Bell,Dark Drone,Soft Pluck,Wide Pad,Air Bell,Dirty Texture,Frozen Choir,Moon Pluck,Tape Organ,Glass Pad}>Preset
slider2:0<-24,24,1>Transpose (semitones)
slider3:0.58<0,1,0.01>Brightness
slider4:0.00<0,1,0.01>Dust
slider5:0.32<0,1,0.01>Detune/Wide
slider6:0.01<0.001,5,0.001>Attack (s)
slider7:0.30<0.01,8,0.01>Release (s)
slider8:0.22<0,1,0.01>Movement
slider9:0.80<0,1,0.01>Output
slider10:0<0,1,1{Poly,Mono}>Poly/Mono
slider11:0.00<0,2,0.001>Glide Time (s)
slider12:0<0,2,1{Off,Legato Only,Always}>Glide Mode
slider13:0<0,1,1{Off,Panic}>Panic
slider14:0<0,4,1{Off,Pure Sine Test,Oscillator Only,Noise Only,Bypass Filter}>Debug Mode
slider15:0<0,3,1{Normal,Phrase Loop,Idea Cycler,Hybrid}>Play Mode
slider16:0<0,1,1{Fixed Root,Incoming Note Latch}>Root Source
slider17:48<0,127,1>Fixed Root MIDI Note
slider18:4<0,4,1{Natural Minor,Phrygian,Harmonic Minor,Chromatic Dirty,Minor Pentatonic}>Scale
slider19:1<0,3,1{1/8,1/16,1/32,1/8 Triplet}>Step Rate
slider20:45<0,100,1>Density pct
slider21:15<0,100,1>Chaos / Wrong Notes pct
slider22:35<1,100,1>Gate pct
slider23:0<0,75,1>Swing pct
slider24:2<0,4,1>Octave Range
slider25:36<0,127,1>Lowest Allowed Note
slider26:84<0,127,1>Highest Allowed Note
slider27:1<0,9999,1>Seed / Variation
slider28:90<1,127,1>Generator Velocity
slider29:20<0,100,1>Velocity Humanize pct
slider30:1<0,1,1{Off,On}>Reset on Transport Start
slider31:1<0,2,1{8 Steps,16 Steps,32 Steps}>Pattern Length
slider32:0<0,5,1{Angular,Sparse,Busy,Rising,Falling,Random}>Motif Shape
slider33:25<0,100,1>Accent Probability pct
slider34:35<0,100,1>Rest Probability pct
slider35:15<0,100,1>Repeat Probability pct
slider36:8<0,100,1>Tie Probability pct
slider37:2<0,4,1{Off,1 bar,2 bars,4 bars,8 bars}>Idea Cycle Length
slider38:45<0,100,1>Mutation Amount pct
slider39:60<0,100,1>Keep Motif pct
slider40:1<0,3,1{1/2 bar,1 bar,2 bars,4 bars}>Burst Length
slider41:1<0,3,1{0,1/2 bar,1 bar,2 bars}>Rest Length
slider42:20<0,100,1>Timbre Drift pct
slider43:55<0,100,1>Home Bias pct
slider44:1<0,1,1{Off,On}>Capture Friendly
in_pin:none
out_pin:left
out_pin:right

@init
voices = 16;
max_events = 256;

// Explicit, non-overlapping JSFX memory regions.
base_active = 0;
base_note = 32;
base_target_freq = 64;
base_current_freq = 96;
base_vel = 128;
base_gate = 160;
base_env = 192;
base_releasing = 224;
base_phase1 = 256;
base_phase2 = 288;
base_phase3 = 320;
base_filtL = 352;
base_filtR = 384;
base_dust = 416;
base_age = 448;
base_pan = 480;
base_start_freq = 512;
base_held = 640;       // 128 MIDI notes.
base_evt_offs = 800;   // 256 queued event offsets.
base_evt_msg1 = 1088;  // 256 queued msg1 values.
base_evt_msg23 = 1376; // 256 queued msg23 values.

pi = 3.141592653589793;
two_pi = 2*pi;
inv_srate = 1/srate;
min_attack_s = 0.010; // Internal anti-click minimum, even if the GUI slider is lower.
noise_seed = 0.314159;
global_age = 1;
lfo_phase = 0;
last_preset = -1;
last_freq = 261.625565;
held_count = 0;
mono_voice = 0;
block_pos = 0;
evt_count = 0;
evt_index = 0;
last_play_mode = 0;
last_play_state = 0;
last_beat_position = 0;
gen_rng = 1;
gen_counter = 0;
gen_note_off_counter = -1;
gen_step_index = 0;
gen_note_is_on = 0;
gen_active_note = -1;
gen_root = 48;
gen_prev_note = 48;
gen_prev_degree = 0;
idea_cycle_index = -1;
idea_cycle_seed = 1;
idea_phase_beats = 0;
brightness_drift = 0;
dust_drift = 0;
movement_drift = 0;
detune_drift = 0;
play_was_running = 0;
bright_amt_eff = 0.58;
dust_amt_eff = 0;
move_amt_eff = 0.22;
detune_amt_eff = 0.32;

function clamp(x lo hi) (
  x < lo ? lo : x > hi ? hi : x;
);

function note_to_freq(n) (
  440 * 2^((n - 69) / 12);
);

function wrap01(x) (
  x - floor(x);
);

function tri(p) local(t) (
  t = wrap01(p);
  4 * abs(t - 0.5) - 1;
);

function saw(p) local(t) (
  t = wrap01(p);
  2 * t - 1;
);

function softclip(x) (
  x / (1 + abs(x));
);

function rand_uni() (
  noise_seed = noise_seed * 12.9898 + 78.233;
  noise_seed = wrap01(noise_seed);
  noise_seed * 2 - 1;
);

function clear_voice(v) (
  base_active[v] = 0;
  base_gate[v] = 0;
  base_env[v] = 0;
  base_releasing[v] = 0;
  base_filtL[v] = 0;
  base_filtR[v] = 0;
  base_dust[v] = 0;
);

function panic_all() local(i) (
  i = 0;
  loop(voices,
    clear_voice(i);
    i += 1;
  );
  i = 0;
  loop(128,
    base_held[i] = 0;
    i += 1;
  );
  held_count = 0;
);

function remember_note_on(n) (
  base_held[n] < 0.5 ? (
    base_held[n] = 1;
    held_count += 1;
  );
);

function remember_note_off(n) (
  base_held[n] > 0.5 ? (
    base_held[n] = 0;
    held_count -= 1;
    held_count < 0 ? held_count = 0;
  );
);

function highest_held_note() local(i found) (
  found = -1;
  i = 127;
  loop(128,
    found < 0 && base_held[i] > 0.5 ? found = i;
    i -= 1;
  );
  found;
);

function choose_voice() local(i best bestenv quiet quietenv oldest oldestage) (
  best = -1;
  bestenv = 999;
  quiet = -1;
  quietenv = 999;
  oldest = 0;
  oldestage = 999999999;
  i = 0;
  loop(voices,
    base_active[i] < 0.5 && best < 0 ? best = i;
    (best < 0 && base_releasing[i] > 0.5 && base_env[i] < bestenv) ? (
      best = i;
      bestenv = base_env[i];
    );
    base_env[i] < quietenv ? (
      quiet = i;
      quietenv = base_env[i];
    );
    base_age[i] < oldestage ? (
      oldest = i;
      oldestage = base_age[i];
    );
    i += 1;
  );
  best < 0 ? (quietenv < 0.08 ? best = quiet : best = oldest);
  best;
);

function setup_voice(v note vel start_freq do_glide reset_env) local(target spread) (
  target = note_to_freq(note + transpose_amt);
  base_active[v] = 1;
  base_note[v] = note;
  base_target_freq[v] = target;
  base_current_freq[v] = do_glide > 0.5 ? start_freq : target;
  base_start_freq[v] = base_current_freq[v];
  base_vel[v] = vel / 127;
  base_gate[v] = 1;
  base_releasing[v] = 0;
  reset_env > 0.5 ? base_env[v] = 0;
  reset_env > 0.5 ? (
    base_filtL[v] = 0;
    base_filtR[v] = 0;
    base_dust[v] = 0;
  );
  // New voices start with decorrelated phases, then fade in through env_audio.
  base_phase1[v] = reset_env > 0.5 ? wrap01(rand_uni() * 0.25) : base_phase1[v];
  base_phase2[v] = reset_env > 0.5 ? wrap01(0.25 + rand_uni() * 0.20) : base_phase2[v];
  base_phase3[v] = reset_env > 0.5 ? wrap01(0.50 + rand_uni() * 0.20) : base_phase3[v];
  spread = (v / max(1, voices - 1) - 0.5);
  base_pan[v] = spread;
  base_age[v] = global_age;
  global_age += 1;
  last_freq = target;
);

function note_on(note vel) local(v target legato do_glide start_freq reset_env) (
  legato = held_count > 0;
  remember_note_on(note);
  target = note_to_freq(note + transpose_amt);
  do_glide = 0;
  glide_mode == 2 ? do_glide = 1;
  glide_mode == 1 && legato ? do_glide = 1;
  glide_time <= 0.00001 ? do_glide = 0;

  mono_mode > 0.5 ? (
    v = mono_voice;
    start_freq = base_active[v] > 0.5 ? base_current_freq[v] : last_freq;
    reset_env = base_active[v] > 0.5 && legato ? 0 : 1;
    setup_voice(v, note, vel, start_freq, do_glide, reset_env);
  ) : (
    v = choose_voice();
    start_freq = glide_mode == 2 ? last_freq : target;
    setup_voice(v, note, vel, start_freq, do_glide, 1);
  );
);

function release_note(note) local(i next_note) (
  remember_note_off(note);

  mono_mode > 0.5 ? (
    next_note = highest_held_note();
    next_note >= 0 ? (
      base_note[mono_voice] == note ? (
        setup_voice(mono_voice, next_note, 100, base_current_freq[mono_voice], glide_time > 0 && glide_mode > 0, 0);
      );
    ) : (
      base_active[mono_voice] > 0.5 ? (
        base_gate[mono_voice] = 0;
        base_releasing[mono_voice] = 1;
      );
    );
  ) : (
    i = 0;
    loop(voices,
      base_active[i] > 0.5 && base_note[i] == note ? (
        base_gate[i] = 0;
        base_releasing[i] = 1;
      );
      i += 1;
    );
  );
);

function all_notes_off() local(i) (
  i = 0;
  loop(128,
    base_held[i] = 0;
    i += 1;
  );
  held_count = 0;
  i = 0;
  loop(voices,
    base_active[i] > 0.5 ? (
      base_gate[i] = 0;
      base_releasing[i] = 1;
    );
    i += 1;
  );
);

function apply_preset_defaults(p) (
  p == 0 ? (slider3=0.58; slider4=0.00; slider5=0.32; slider6=0.012; slider7=0.30; slider8=0.22; slider9=0.80; slider11=0.000; slider12=0;)
  : p == 1 ? (slider3=0.38; slider4=0.30; slider5=0.55; slider6=0.280; slider7=2.40; slider8=0.45; slider9=0.76; slider11=0.020; slider12=2;)
  : p == 2 ? (slider3=0.72; slider4=0.20; slider5=0.28; slider6=0.012; slider7=1.20; slider8=0.28; slider9=0.72; slider11=0.000; slider12=0;)
  : p == 3 ? (slider3=0.22; slider4=0.10; slider5=0.42; slider6=0.600; slider7=4.00; slider8=0.55; slider9=0.70; slider11=0.080; slider12=2;)
  : p == 4 ? (slider3=0.62; slider4=0.04; slider5=0.20; slider6=0.012; slider7=0.22; slider8=0.16; slider9=0.78; slider11=0.030; slider12=1;)
  : p == 5 ? (slider3=0.48; slider4=0.08; slider5=0.78; slider6=0.450; slider7=3.20; slider8=0.38; slider9=0.76; slider11=0.040; slider12=2;)
  : p == 6 ? (slider3=0.84; slider4=0.06; slider5=0.24; slider6=0.012; slider7=1.00; slider8=0.20; slider9=0.72; slider11=0.000; slider12=0;)
  : p == 7 ? (slider3=0.42; slider4=0.45; slider5=0.50; slider6=0.040; slider7=1.80; slider8=0.48; slider9=0.70; slider11=0.020; slider12=2;)
  : p == 8 ? (slider3=0.30; slider4=0.05; slider5=0.62; slider6=0.900; slider7=4.80; slider8=0.42; slider9=0.74; slider11=0.060; slider12=2;)
  : p == 9 ? (slider3=0.70; slider4=0.03; slider5=0.18; slider6=0.014; slider7=0.38; slider8=0.18; slider9=0.76; slider11=0.020; slider12=1;)
  : p == 10 ? (slider3=0.44; slider4=0.18; slider5=0.34; slider6=0.080; slider7=1.10; slider8=0.25; slider9=0.78; slider11=0.030; slider12=2;)
  : (slider3=0.78; slider4=0.04; slider5=0.52; slider6=0.350; slider7=3.00; slider8=0.35; slider9=0.72; slider11=0.020; slider12=2;);

  // REAPER supports sliderchange(mask). Bits 1..12 update sliders 2..13 visibly after a preset jump.
  sliderchange(8190);
);

function update_preset_color(p) (
  p == 0 ? (wave_mix=0.18; bell_mix=0.05; sub_mix=0.08; cutoff_base=0.42; dust_trim=0.20; amp_trim=0.62; rel_scale=1.0;)
  : p == 1 ? (wave_mix=0.45; bell_mix=0.05; sub_mix=0.18; cutoff_base=0.28; dust_trim=0.55; amp_trim=0.56; rel_scale=1.4;)
  : p == 2 ? (wave_mix=0.08; bell_mix=0.55; sub_mix=0.01; cutoff_base=0.48; dust_trim=0.36; amp_trim=0.54; rel_scale=1.0;)
  : p == 3 ? (wave_mix=0.70; bell_mix=0.00; sub_mix=0.32; cutoff_base=0.16; dust_trim=0.24; amp_trim=0.52; rel_scale=1.6;)
  : p == 4 ? (wave_mix=0.34; bell_mix=0.10; sub_mix=0.01; cutoff_base=0.38; dust_trim=0.22; amp_trim=0.60; rel_scale=0.8;)
  : p == 5 ? (wave_mix=0.36; bell_mix=0.04; sub_mix=0.20; cutoff_base=0.32; dust_trim=0.24; amp_trim=0.54; rel_scale=1.5;)
  : p == 6 ? (wave_mix=0.00; bell_mix=0.65; sub_mix=0.00; cutoff_base=0.55; dust_trim=0.20; amp_trim=0.52; rel_scale=1.0;)
  : p == 7 ? (wave_mix=0.62; bell_mix=0.12; sub_mix=0.16; cutoff_base=0.24; dust_trim=0.70; amp_trim=0.50; rel_scale=1.2;)
  : p == 8 ? (wave_mix=0.22; bell_mix=0.03; sub_mix=0.26; cutoff_base=0.18; dust_trim=0.16; amp_trim=0.55; rel_scale=1.7;)
  : p == 9 ? (wave_mix=0.18; bell_mix=0.22; sub_mix=0.00; cutoff_base=0.50; dust_trim=0.14; amp_trim=0.58; rel_scale=0.8;)
  : p == 10 ? (wave_mix=0.30; bell_mix=0.02; sub_mix=0.18; cutoff_base=0.30; dust_trim=0.38; amp_trim=0.58; rel_scale=1.0;)
  : (wave_mix=0.04; bell_mix=0.48; sub_mix=0.02; cutoff_base=0.52; dust_trim=0.18; amp_trim=0.50; rel_scale=1.5;);
);


function render_voice(v) local(env cur target bend det inc1 inc2 inc3 ph1 ph2 ph3 env_audio s1 t1 sw bp main_osc sub_fade sub_osc dust_state dust_sig sig cutoff coef fl fr pan pure) (
  env = base_env[v];
  base_gate[v] > 0.5 ? (
    env += attack_inc;
    env > 1 ? env = 1;
  ) : (
    env -= release_dec;
    env <= 0.000001 ? (
      env = 0;
      clear_voice(v);
    );
  );
  base_env[v] = env;

  base_active[v] > 0.5 ? (
    env_audio = env * env * (3 - 2 * env);
    cur = base_current_freq[v];
    target = base_target_freq[v];
    cur += (target - cur) * glide_coef;
    base_current_freq[v] = cur;

    bend = 1 + lfo * move_amt_eff * 0.002;
    det = detune_amt_eff * 0.005;
    inc1 = cur * bend * inv_srate;
    inc2 = cur * (1 + det) * (1 - lfo * move_amt_eff * 0.0008) * inv_srate;
    inc3 = cur * 2.01 * inv_srate;
    ph1 = wrap01(base_phase1[v] + inc1);
    ph2 = wrap01(base_phase2[v] + inc2);
    ph3 = wrap01(base_phase3[v] + inc3);
    base_phase1[v] = ph1;
    base_phase2[v] = ph2;
    base_phase3[v] = ph3;

    pure = sin(two_pi * ph1);
    s1 = pure;
    t1 = tri(ph1);
    sw = saw(ph2);
    bp = sin(two_pi * ph3) * bell_mix;
    main_osc = (s1 * (1 - wave_mix) + t1 * wave_mix * 0.70 + sw * wave_mix * 0.30) * (1 - bell_mix * 0.30);
    sub_fade = min(1, env * 10);
    sub_osc = sin(two_pi * wrap01(ph1 * 0.5)) * sub_mix * sub_fade;
    osc_signal = main_osc + bp + sub_osc;

    dust_state = base_dust[v] * 0.98 + rand_uni() * 0.02;
    base_dust[v] = dust_state;
    dust_sig = dust_amt_eff <= 0 ? 0 : dust_state * dust_amt_eff * dust_trim * 0.14;

    debug_mode == 1 ? sig = pure * env_audio * base_vel[v]
    : debug_mode == 2 ? sig = osc_signal * env_audio * base_vel[v] * amp_trim
    : debug_mode == 3 ? sig = dust_sig * env_audio * base_vel[v] * 2.5
    : sig = (osc_signal + dust_sig) * env_audio * base_vel[v] * amp_trim;

    debug_mode == 1 || debug_mode == 2 || debug_mode == 3 || debug_mode == 4 ? (
      fl = sig;
      fr = sig;
    ) : (
      cutoff = cutoff_base + bright_amt_eff * 0.52 + lfo * move_amt_eff * 0.06;
      cutoff = clamp(cutoff, 0.08, 0.98);
      coef = max(0.003, cutoff * cutoff);
      fl = base_filtL[v] + coef * (sig - base_filtL[v]);
      fr = base_filtR[v] + coef * (sig - base_filtR[v]);
      base_filtL[v] = fl;
      base_filtR[v] = fr;
    );

    pan = base_pan[v] * detune_amt_eff * 0.65;
    sumL += fl * (0.707 - pan);
    sumR += fr * (0.707 + pan);
  );
);

function gen_srand(seed) (
  gen_rng = seed + 1;
);

function gen_rand01() (
  gen_rng = wrap01(gen_rng * 12.9898 + 0.12345);
  gen_rng;
);

function pattern_steps() (
  pattern_len_mode == 0 ? 8 : pattern_len_mode == 1 ? 16 : 32;
);

function step_beats() (
  step_rate == 0 ? 0.5 : step_rate == 1 ? 0.25 : step_rate == 2 ? 0.125 : 1/3;
);

function scale_size(sc) (
  sc == 3 ? 12 : sc == 4 ? 5 : 7;
);

function scale_interval(sc deg) local(d) (
  d = deg - floor(deg / scale_size(sc)) * scale_size(sc);
  sc == 0 ? (d == 0 ? 0 : d == 1 ? 2 : d == 2 ? 3 : d == 3 ? 5 : d == 4 ? 7 : d == 5 ? 8 : 10)
  : sc == 1 ? (d == 0 ? 0 : d == 1 ? 1 : d == 2 ? 3 : d == 3 ? 5 : d == 4 ? 7 : d == 5 ? 8 : 10)
  : sc == 2 ? (d == 0 ? 0 : d == 1 ? 2 : d == 2 ? 3 : d == 3 ? 5 : d == 4 ? 7 : d == 5 ? 8 : 11)
  : sc == 3 ? d
  : (d == 0 ? 0 : d == 1 ? 3 : d == 2 ? 5 : d == 3 ? 7 : 10);
);

function clamp_generated_note(n) (
  clamp(n, gen_low, gen_high);
);

function pick_scale_note() local(sz deg oct note r jump wrong) (
  sz = scale_size(gen_scale);
  r = gen_rand01();
  gen_rand01() * 100 < repeat_prob ? (
    note = gen_prev_note;
  ) : (
    motif_shape == 1 ? deg = floor(gen_rand01() * 3)
    : motif_shape == 2 ? deg = floor(gen_rand01() * sz)
    : motif_shape == 3 ? deg = gen_step_index - floor(gen_step_index / sz) * sz
    : motif_shape == 4 ? deg = sz - 1 - (gen_step_index - floor(gen_step_index / sz) * sz)
    : motif_shape == 5 ? deg = floor(gen_rand01() * sz)
    : (
      jump = floor(gen_rand01() * 5) - 2;
      abs(jump) < 1 ? jump = 3;
      deg = gen_prev_degree + jump;
      deg < 0 ? deg = -deg;
    );
    oct = floor(gen_rand01() * (gen_oct_range + 1));
    wrong = gen_rand01() * 100 < gen_chaos;
    note = gen_root + scale_interval(gen_scale, deg) + oct * 12;
    wrong ? note += floor(gen_rand01() * 7) - 3;
    gen_rand01() * 100 < home_bias ? note = gen_root + (gen_rand01() < 0.55 ? 0 : 7) + oct * 12;
    gen_prev_degree = deg;
  );
  note = clamp_generated_note(note);
  gen_prev_note = note;
  note;
);

function generator_note_off() (
  gen_note_is_on > 0.5 ? (
    release_note(gen_active_note);
    gen_note_is_on = 0;
    gen_active_note = -1;
  );
);

function generator_note_on(n vel) (
  generator_note_off();
  note_on(n, vel);
  gen_active_note = n;
  gen_note_is_on = 1;
);

function generator_reset() (
  generator_note_off();
  gen_srand(gen_seed);
  gen_counter = 0;
  gen_note_off_counter = -1;
  gen_step_index = 0;
  gen_root = root_source == 0 ? fixed_root : gen_root;
  gen_prev_note = gen_root;
  gen_prev_degree = 0;
);

function idea_cycle_beats() (
  idea_cycle_len == 0 ? 0 : idea_cycle_len == 1 ? 4 : idea_cycle_len == 2 ? 8 : idea_cycle_len == 3 ? 16 : 32;
);

function burst_beats() (
  burst_len == 0 ? 2 : burst_len == 1 ? 4 : burst_len == 2 ? 8 : 16;
);

function rest_beats() (
  rest_len == 0 ? 0 : rest_len == 1 ? 2 : rest_len == 2 ? 4 : 8;
);

function update_idea_cycle() local(cyc idx drift) (
  play_mode == 2 ? (
    cyc = idea_cycle_beats();
    cyc <= 0 ? cyc = 4;
    idx = floor(beat_position / cyc);
    idx != idea_cycle_index ? (
      idea_cycle_index = idx;
      idea_cycle_seed = gen_seed + idx * 97 + floor(mutation_amt * 13);
      gen_srand(idea_cycle_seed);
      drift = (gen_rand01() * 2 - 1) * timbre_drift * 0.01;
      brightness_drift = drift * 0.18;
      dust_drift = (gen_rand01() * 2 - 1) * timbre_drift * 0.01 * 0.12;
      movement_drift = gen_rand01() * timbre_drift * 0.01 * 0.18;
      detune_drift = (gen_rand01() * 2 - 1) * timbre_drift * 0.01 * 0.16;
    );
  ) : (
    brightness_drift = 0;
    dust_drift = 0;
    movement_drift = 0;
    detune_drift = 0;
  );
);

function generator_step() local(note vel spb step_samps gate_samps dens rest tie accent human swing_samps phase cyc active_burst mut keep) (
  spb = srate * 60 / max(20, tempo);
  step_samps = step_beats() * spb;
  play_mode == 1 && (gen_step_index - floor(gen_step_index / pattern_steps()) * pattern_steps() == 0) ? gen_srand(gen_seed + 101);
  update_idea_cycle();

  mut = play_mode == 2 ? mutation_amt : 0;
  keep = play_mode == 2 ? keep_motif : 100;
  dens = gen_density + mut * 0.12 - keep * 0.04;
  motif_shape == 1 ? dens *= 0.70;
  motif_shape == 2 ? dens = min(100, dens * 1.25);
  rest = rest_prob + mut * 0.10;
  capture_friendly > 0.5 ? (dens *= 0.75; rest += 15;);
  play_mode == 2 ? (
    cyc = max(0.001, burst_beats() + rest_beats());
    phase = beat_position - floor(beat_position / cyc) * cyc;
    active_burst = phase < burst_beats();
    active_burst < 0.5 ? rest = 100;
  );
  dens = clamp(dens, 0, 100);
  rest = clamp(rest, 0, 100);
  gen_note_is_on > 0.5 && gen_rand01() * 100 < tie_prob ? (
    gen_note_off_counter = max(gen_note_off_counter, step_samps * gen_gate * 0.01);
  ) : (
    generator_note_off();
    (gen_rand01() * 100 < dens && gen_rand01() * 100 >= rest) ? (
      note = pick_scale_note();
      human = (gen_rand01() * 2 - 1) * gen_vel_human * 0.01 * 32;
      accent = gen_rand01() * 100 < accent_prob ? 24 : 0;
      vel = clamp(gen_velocity + human + accent, 1, 127);
      generator_note_on(note, vel);
      gate_samps = max(4, step_samps * gen_gate * 0.01);
      gen_note_off_counter = gate_samps;
    );
  );

  swing_samps = (gen_step_index - floor(gen_step_index / 2) * 2) == 0 ? 0 : step_samps * gen_swing * 0.01 * 0.5;
  gen_counter = max(1, step_samps + swing_samps);
  gen_step_index += 1;
);

@slider
preset = slider1;
preset != last_preset ? (
  all_notes_off();
  apply_preset_defaults(preset);
  last_preset = preset;
);

transpose_amt = slider2;
bright_amt = clamp(slider3, 0, 1);
dust_amt = clamp(slider4, 0, 1);
detune_amt = clamp(slider5, 0, 1);
attack_s = max(min_attack_s, slider6);
release_s = max(0.02, slider7);
move_amt = clamp(slider8, 0, 1);
out_amt = clamp(slider9, 0, 1);
mono_mode = slider10;
glide_time = max(0, slider11);
glide_mode = slider12;
debug_mode = slider14;
play_mode = slider15;
root_source = slider16;
fixed_root = slider17;
gen_scale = slider18;
step_rate = slider19;
gen_density = slider20;
gen_chaos = slider21;
gen_gate = slider22;
gen_swing = slider23;
gen_oct_range = slider24;
gen_low = min(slider25, slider26);
gen_high = max(slider25, slider26);
gen_seed = slider27;
gen_velocity = slider28;
gen_vel_human = slider29;
reset_on_start = slider30;
pattern_len_mode = slider31;
motif_shape = slider32;
accent_prob = slider33;
rest_prob = slider34;
repeat_prob = slider35;
tie_prob = slider36;
idea_cycle_len = slider37;
mutation_amt = slider38;
keep_motif = slider39;
burst_len = slider40;
rest_len = slider41;
timbre_drift = slider42;
home_bias = slider43;
capture_friendly = slider44;

play_mode != last_play_mode ? (
  all_notes_off();
  generator_reset();
  last_play_mode = play_mode;
);

slider13 > 0.5 ? (
  panic_all();
  slider13 = 0;
  sliderchange(4096);
);

update_preset_color(preset);
bright_amt_eff = clamp(bright_amt + brightness_drift, 0, 1);
dust_amt_eff = clamp(dust_amt + dust_drift, 0, 1);
move_amt_eff = clamp(move_amt + movement_drift, 0, 1);
detune_amt_eff = clamp(detune_amt + detune_drift, 0, 1);
attack_inc = 1 / max(1, attack_s * srate);
release_dec = 1 / max(1, release_s * rel_scale * srate);
glide_coef = glide_time <= 0.00001 ? 1 : 1 - exp(-1 / max(1, glide_time * srate));

@block
block_pos = 0;
evt_count = 0;
evt_index = 0;
while (midirecv(offset, msg1, msg23)) (
  evt_count < max_events ? (
    base_evt_offs[evt_count] = offset;
    base_evt_msg1[evt_count] = msg1;
    base_evt_msg23[evt_count] = msg23;
    evt_count += 1;
  );
);
// Events are queued and consumed in @sample when block_pos reaches their offset,
// so Piano-Roll/MIDI-item notes remain sample-accurate without risky audio buffers.

@sample
while (evt_index < evt_count && base_evt_offs[evt_index] <= block_pos) (
  msg1 = base_evt_msg1[evt_index];
  msg23 = base_evt_msg23[evt_index];
  status = msg1 & 240;
  note = msg23 & 127;
  vel = (msg23 >> 8) & 127;
  cc = msg23 & 127;
  ccval = (msg23 >> 8) & 127;

  status == 144 && vel > 0 ? (
    root_source == 1 ? gen_root = note;
    play_mode == 0 || play_mode == 3 ? note_on(note, vel);
  ) : ((status == 128) || (status == 144 && vel == 0)) ? (
    play_mode == 0 || play_mode == 3 ? release_note(note);
  ) : (status == 176 && cc == 123) ? (
    all_notes_off();
    generator_note_off();
  );
  evt_index += 1;
);
block_pos += 1;

(play_state & 1) == 0 ? (
  generator_note_off();
  all_notes_off();
  play_was_running = 0;
) : (
  reset_on_start > 0.5 && (play_was_running < 0.5 || beat_position < last_beat_position) ? generator_reset();
  play_was_running = 1;
  play_mode > 0.5 ? (
    root_source == 0 ? gen_root = fixed_root;
    gen_note_off_counter >= 0 ? (
      gen_note_off_counter -= 1;
      gen_note_off_counter <= 0 ? (generator_note_off(); gen_note_off_counter = -1;);
    );
    gen_counter -= 1;
    gen_counter <= 0 ? generator_step();
  ) : (
    generator_note_off();
  );
);
last_beat_position = beat_position;

bright_amt_eff = clamp(bright_amt + brightness_drift, 0, 1);
dust_amt_eff = clamp(dust_amt + dust_drift, 0, 1);
move_amt_eff = clamp(move_amt + movement_drift, 0, 1);
detune_amt_eff = clamp(detune_amt + detune_drift, 0, 1);

lfo_phase += (0.025 + move_amt_eff * 0.10) * inv_srate;
lfo_phase = wrap01(lfo_phase);
lfo = sin(two_pi * lfo_phase);

sumL = 0;
sumR = 0;
scale = 0.72;

i = 0;
loop(voices,
  base_active[i] > 0.5 ? render_voice(i);
  i += 1;
);

output_drive = debug_mode == 1 ? 0.95 : debug_mode == 3 ? 1.20 : 0.95;
spl0 = softclip(sumL * scale * out_amt * output_drive);
spl1 = softclip(sumR * scale * out_amt * output_drive);
